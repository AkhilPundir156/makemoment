{
    "extends": "../../packages/typescript-config/base.json",
    "compilerOptions": {
        "paths": {
            "@makemymoment/typescript-config/*": ["../../packages/typescript-config/*"],
            "@makemymoment/types": ["../../packages/types"]
        },
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "module": "esnext",
        "moduleResolution": "Node"
    },
    "include": ["src"],
    "exclude": ["node_modules"],
    "references": [{ "path": "../types/" }]
}
